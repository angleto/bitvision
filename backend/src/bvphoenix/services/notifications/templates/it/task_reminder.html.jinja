<!doctype html>
<html lang="it">
<body style="font-family: -apple-system, system-ui, Segoe UI, Helvetica, Arial, sans-serif; color: #1f2937; max-width: 560px; margin: 0 auto; padding: 1.2rem;">
  <h1 style="font-size: 1.1rem; margin: 0 0 1rem;">Promemoria attività</h1>
  <p>{% if patient_first_name %}Ciao {{ patient_first_name }},{% else %}Salve,{% endif %}</p>
  <p>ti ricordiamo l'attività operativa <strong>{{ event_title }}</strong>{% if event_when_local %} da completare entro <strong>{{ event_when_local }}</strong>{% endif %}.</p>
  {% if app_url -%}
  <p><a href="{{ app_url }}" style="color: #4f46e5;">Apri l'attività sul fascicolo</a></p>
  {% endif -%}
  <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0;">
  <p style="font-size: 0.8rem; color: #6b7280;">
    Se non vuoi più ricevere questi promemoria, <a href="{{ opt_out_url }}" style="color: #6b7280;">annulla la sottoscrizione</a>.
    <br>— bitvision phoenix
  </p>
</body>
</html>
