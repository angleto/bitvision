<!doctype html>
<html lang="en">
<body style="font-family: -apple-system, system-ui, Segoe UI, Helvetica, Arial, sans-serif; color: #1f2937; max-width: 560px; margin: 0 auto; padding: 1.2rem;">
  <h1 style="font-size: 1.1rem; margin: 0 0 1rem;">Appointment follow-up</h1>
  <p>{% if patient_first_name %}Hi {{ patient_first_name }},{% else %}Hello,{% endif %}</p>
  <p>quick follow-up on the appointment <strong>{{ event_title }}</strong>{% if event_when_local %} on <strong>{{ event_when_local }}</strong>{% endif %}: remember to record the outcome on the record.</p>
  {% if app_url -%}
  <p><a href="{{ app_url }}" style="color: #4f46e5;">Open the record</a></p>
  {% endif -%}
  <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0;">
  <p style="font-size: 0.8rem; color: #6b7280;">
    <a href="{{ opt_out_url }}" style="color: #6b7280;">Unsubscribe</a>
    <br>— bitvision phoenix
  </p>
</body>
</html>
