<!doctype html>
<html lang="en">
<body style="font-family: -apple-system, system-ui, Segoe UI, Helvetica, Arial, sans-serif; color: #1f2937; max-width: 560px; margin: 0 auto; padding: 1.2rem;">
  <h1 style="font-size: 1.1rem; margin: 0 0 1rem;">Appointment reminder</h1>
  <p>{% if patient_first_name %}Hi {{ patient_first_name }},{% else %}Hello,{% endif %}</p>
  <p>quick reminder for the appointment <strong>{{ event_title }}</strong> scheduled at <strong>{{ event_when_local }}</strong>{% if event_where %} at {{ event_where }}{% endif %}.</p>
  {% if event_meeting_url -%}
  <p><a href="{{ event_meeting_url }}" style="color: #4f46e5;">Join link</a></p>
  {% endif -%}
  {% if app_url -%}
  <p><a href="{{ app_url }}" style="color: #4f46e5;">Open the record</a></p>
  {% endif -%}
  <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 1.5rem 0;">
  <p style="font-size: 0.8rem; color: #6b7280;">
    If you no longer want to receive these reminders, <a href="{{ opt_out_url }}" style="color: #6b7280;">unsubscribe</a>.
    <br>— bitvision phoenix
  </p>
</body>
</html>
