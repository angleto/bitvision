# bitvision phoenix — environment variables (development defaults)
# Copy to .env and adjust. Never commit .env with real secrets.

# --- Backend (FastAPI) ---
BVP_ENV=development
BVP_LOG_LEVEL=INFO
BVP_DATABASE_URL=postgresql+asyncpg://bvphoenix:bvphoenix@localhost:5432/bvphoenix
# Sync URL used by the bvphoenix-import CLI (psycopg v3 driver).
BVP_DATABASE_URL_SYNC=postgresql+psycopg://bvphoenix:bvphoenix@localhost:5432/bvphoenix
BVP_REDIS_URL=redis://localhost:6379/0

# --- S3-compatible object storage ---
# Dev: MinIO on localhost. Prod: R2 / B2 / S3.
BVP_S3_ENDPOINT_URL=http://localhost:9000
BVP_S3_REGION=us-east-1
BVP_S3_ACCESS_KEY=bvphoenix
BVP_S3_SECRET_KEY=bvphoenix-dev-secret
BVP_S3_BUCKET_RAW=bvphoenix-raw
BVP_S3_BUCKET_DERIVATIVES=bvphoenix-derivatives
# Server-side encryption. Default in code is AES256, but MinIO senza KES la rifiuta.
# Per dev contro MinIO usare "none". In prod (R2/B2/AWS) "AES256" o "aws:kms".
BVP_S3_ENCRYPTION=none

# --- Auth (Authentik OIDC) ---
BVP_OIDC_ISSUER=http://localhost:9001/application/o/bvphoenix/
BVP_OIDC_CLIENT_ID=bvphoenix-dev
BVP_OIDC_CLIENT_SECRET=CHANGE_ME

# --- LLM providers (leave empty for BYOK-only mode) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=bitvision phoenix
